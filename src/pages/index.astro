---
import Layout from '../layouts/Layout.astro';

const assetBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const services = [
  {
    icon: '🎵',
    title: 'Venda de shows',
    description: 'Intermediação, negociação e contratação de artistas com suporte completo para eventuais demandas do seu evento.',
  },
  {
    icon: '🎤',
    title: 'Produção executiva',
    description: 'Planejamento, cronograma, fornecedores e coordenação para transformar a ideia em uma etapa bem executada.',
  },
  {
    icon: '🚚',
    title: 'Logística',
    description: 'Transporte, hospedagem, transfers e apoio operacional para manter a operação em movimento com segurança.',
  },
  {
    icon: '🛏️',
    title: 'Camarins',
    description: 'Preparação da estrutura de conforto, descanso e atendimento para artistas e equipe que atuam no evento.',
  },
  {
    icon: '📍',
    title: 'Produção local',
    description: 'Equipe no local para montagem, operação e acompanhamento do dia do evento, com atenção aos detalhes.',
  },
  {
    icon: '🤝',
    title: 'Gestão artística',
    description: 'Relacionamento, planejamento e acompanhamento do artista e da operação contratada durante o processo.',
  },
];

const artists = [
  { name: 'Clássicos e novos nomes', type: 'sertanejo', label: 'Seleção CB Shows', image: `${assetBase}images/show-artists-1.png` },
  { name: 'Grandes vozes do sertanejo', type: 'pop', label: 'Artistas em destaque', image: `${assetBase}images/show-artists-2.png` },
  { name: 'Duplas e formatos especiais', type: 'band', label: 'Curadoria personalizada', image: `${assetBase}images/show-artists-3.png` },
];

const processSteps = [
  { number: '01', title: 'Conte sobre o evento', description: 'Informe data, local, perfil do público e a necessidade do seu projeto.' },
  { number: '02', title: 'Receba a curadoria', description: 'A equipe avalia artistas, disponibilidade e escopo operacional da sua demanda.' },
  { number: '03', title: 'Analise a proposta', description: 'Você recebe condições, custos e próximos passos para decidir com clareza.' },
  { number: '04', title: 'Realize o evento', description: 'A CB Shows coordena a contratação e a operação até a execução final.' },
];

const features = [
  { title: 'Um ponto de contato', description: 'Contratação, produção e logística centralizadas em uma operação só.' },
  { title: 'Relacionamento profissional', description: 'Acesso a artistas e escritórios com comunicação clara e profissional.' },
  { title: 'Operação adaptada', description: 'Estrutura pensada para o porte, o formato e a demanda do evento.' },
  { title: 'Rider e camarim alinhados', description: 'Acompanhamento de estrutura técnica e atendimento do artista e da equipe.' },
  { title: 'Acompanhamento completo', description: 'Planejamento, execução e suporte de ponta a ponta durante o evento.' },
  { title: 'Atuação nacional', description: 'Coordenação em todo o Brasil, com base em Goiânia e alcance nacional.' },
];

const faqs = [
  {
    q: 'A CB Shows atende eventos em todo o Brasil?',
    a: 'Sim. A operação funciona com coordenação nacional e apoio em diferentes praças do país. A composição do preço e do escopo varia conforme data, local e contrato do artista.',
  },
  {
    q: 'É possível contratar apenas produção ou logística?',
    a: 'Sim. A CB Shows pode atender demandas específicas de produção executiva, logística ou gestão complementar, sem necessariamente depender de uma contratação de show única.',
  },
  {
    q: 'Como funciona a consulta de disponibilidade do artista?',
    a: 'A equipe avalia a demanda do evento e consulta a disponibilidade junto ao escritório ou gestor do artista. As condições e a confirmação dependem da data, do local e da negociação.',
  },
  {
    q: 'Quais informações são necessárias para receber uma cotação?',
    a: 'As informações iniciais mais importantes são data desejada, cidade/estado, tipo de evento, público estimado, formato e a demanda de artistas ou serviços. Isso ajuda a preparar a primeira curadoria.',
  },
  {
    q: 'A CB Shows também indica artistas para o perfil do evento?',
    a: 'Sim. A operação pode indicar artistas e estilos alinhados ao público e ao objetivo do evento, considerando também o tipo de produção e a viabilidade do evento.',
  },
  {
    q: 'O valor do show já inclui transporte, hospedagem e produção?',
    a: 'Não necessariamente. O preço pode variar conforme o contrato com o artista, a logística envolvida e os serviços adicionais como produção local, hospedagem, transporte e rider. Cada escopo é calculado de forma específica.',
  },
];
---

<Layout>
  <header class="site-header">
    <div class="container">
      <a class="brand" href="#top" aria-label="CB Shows home">
        <img class="brand-logo" src={`${assetBase}images/logo-cb-shows.png`} alt="CB Shows" />
      </a>

      <nav class="nav" id="site-nav" aria-label="Menu principal">
        <a href="#servicos">Serviços</a>
        <a href="#artistas">Artistas</a>
        <a href="#como-funciona">Como funciona</a>
        <a href="#contato">Contato</a>
      </nav>

      <div class="header-actions">
        <a class="btn btn-ghost" href="#contato">Falar no WhatsApp</a>
        <a class="btn btn-primary" href="#contato">Solicitar cotação</a>
        <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menu" aria-expanded="false">☰</button>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Artistas • Produção • Eventos</p>
          <h1>CB Shows: artistas, produção e grandes eventos em uma só operação</h1>
          <p class="lead">
            Da contratação à execução, conectamos seu evento aos artistas certos e coordenamos
            produção, logística e operação em todo o Brasil.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#contato">Solicitar cotação</a>
            <a class="btn btn-secondary" href="https://wa.me/556299998934" target="_blank" rel="noreferrer">Falar no WhatsApp</a>
          </div>

          <div class="trust-badge">Base em Goiânia. Atuação nacional.</div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="stage-board">
            <img class="stage-hero-image" src={`${assetBase}images/show-artists-1.png`} alt="Artistas em apresentação no palco" />
            <div class="stage-status">
              <small>Atendimento</small>
              <strong>+100 contratos</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="container trust-strip">
        <div class="trust-grid">
          <div class="trust-card">
            <span>Negociação</span>
            <strong>Com artistas e escritórios</strong>
          </div>
          <div class="trust-card">
            <span>Execução</span>
            <strong>Produção e logística integradas</strong>
          </div>
          <div class="trust-card">
            <span>Alcance</span>
            <strong>Coordenação nacional a partir de Goiânia</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-surface" id="servicos">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Serviços</p>
          <h2>Estrutura completa para o seu evento</h2>
          <p class="lead">
            A CB Shows atua com oferta completa para a contratação, a produção e a operação de eventos com foco em clareza, praticidade e resultado.
          </p>
        </div>

        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card">
              <div class="service-icon" aria-hidden="true">{service.icon}</div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <a class="card-link" href="#contato">Cotar este serviço</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="artistas">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Artistas e estilos</p>
          <h2>Encontre o perfil mais adequado para o seu público</h2>
          <p class="lead">
            Explore estilos musicais e formatos para montar uma programação que faça sentido para a proposta do evento.
          </p>
        </div>

        <div class="filter-bar" aria-label="Filtros de artistas">
          <button class="filter-chip active" type="button" data-filter="all">Todos</button>
          <button class="filter-chip" type="button" data-filter="sertanejo">Seleção CB Shows</button>
          <button class="filter-chip" type="button" data-filter="pop">Artistas em destaque</button>
          <button class="filter-chip" type="button" data-filter="band">Formatos especiais</button>
        </div>

        <div class="artist-grid" id="artist-grid">
          {artists.map((artist) => (
            <article class={`artist-card`} data-category={artist.type}>
              <img class="artist-thumb" src={artist.image} alt={`Artistas: ${artist.name}`} loading="lazy" />
              <div class="artist-info">
                <span class="artist-tag">{artist.label}</span>
                <h3>{artist.name}</h3>
                <a class="card-link" href="#contato">Consultar disponibilidade</a>
              </div>
            </article>
          ))}

          <div class="artist-empty" id="artist-empty">
            Não encontramos artistas nesta combinação. Fale com a equipe para receber sugestões para o seu evento.
          </div>
        </div>
      </div>
    </section>

    <section class="section section-surface" id="como-funciona">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Como funciona</p>
          <h2>Um processo simples, claro e profissional</h2>
          <p class="lead">
            Entender cada etapa do processo reduz incertezas e acelera sua tomada de decisão.
          </p>
        </div>

        <div class="process-grid">
          {processSteps.map((step) => (
            <article class="process-card">
              <div class="process-number">{step.number}</div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Diferenciais</p>
          <h2>Menos fornecedores para coordenar. Mais controle sobre o evento.</h2>
        </div>

        <div class="feature-grid">
          {features.map((feature) => (
            <article class="feature-card">
              <div class="feature-bullet" aria-hidden="true"></div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-surface" id="faq">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Perguntas frequentes</p>
          <h2>Respostas que ajudam a decidir com mais segurança</h2>
        </div>

        <div class="faq-grid">
          {faqs.map((faq) => (
            <details class="faq-item" open>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="contato">
      <div class="container">
        <div class="contact-shell">
          <div class="contact-copy">
            <p class="eyebrow">Cotação</p>
            <h2>Conte o que você está planejando</h2>
            <p>
              Envie os dados iniciais do evento. Nossa equipe entra em contato para entender o escopo, consultar disponibilidade e preparar os próximos passos.
            </p>

            <div class="contact-points">
              <span><strong>WhatsApp:</strong> (62) 99998-8935</span>
              <span><strong>E-mail:</strong> grupocbshows@gmail.com</span>
              <span><strong>Base:</strong> Goiânia / GO</span>
            </div>
          </div>

          <div class="form-card">
            <form id="quote-form" novalidate>
              <div class="form-grid">
                <div class="field">
                  <label for="name">Nome completo</label>
                  <input id="name" name="name" type="text" required />
                </div>

                <div class="field">
                  <label for="phone">Telefone/WhatsApp</label>
                  <input id="phone" name="phone" type="tel" required />
                </div>

                <div class="field">
                  <label for="email">E-mail</label>
                  <input id="email" name="email" type="email" required />
                </div>

                <div class="field">
                  <label for="demand">Tipo de demanda</label>
                  <select id="demand" name="demand" required>
                    <option value="">Selecione</option>
                    <option>Contratação de show</option>
                    <option>Produção executiva</option>
                    <option>Logística</option>
                    <option>Festival</option>
                    <option>Evento corporativo</option>
                    <option>Gestão artística</option>
                    <option>Outro</option>
                  </select>
                </div>

                <div class="field">
                  <label for="eventType">Tipo de evento</label>
                  <input id="eventType" name="eventType" type="text" required />
                </div>

                <div class="field">
                  <label for="location">Cidade e estado</label>
                  <input id="location" name="location" type="text" required />
                </div>

                <div class="field">
                  <label for="date">Data desejada</label>
                  <div class="inline-date">
                    <input id="date" name="date" type="date" required />
                    <label class="checkbox-row" for="dateOpen">
                      <input id="dateOpen" name="dateOpen" type="checkbox" />
                      <span>Data ainda não definida</span>
                    </label>
                  </div>
                </div>

                <div class="field">
                  <label for="audience">Público estimado</label>
                  <input id="audience" name="audience" type="text" />
                </div>

                <div class="field full">
                  <label for="artistInterest">Artista ou estilo de interesse</label>
                  <input id="artistInterest" name="artistInterest" type="text" />
                </div>

                <div class="field full">
                  <label for="message">Mensagem</label>
                  <textarea id="message" name="message"></textarea>
                </div>

                <div class="field full">
                  <label class="checkbox-row" for="privacy">
                    <input id="privacy" name="privacy" type="checkbox" required />
                    <span>Concordo com a Política de Privacidade e autorizo o contato para avaliar a solicitação.</span>
                  </label>
                </div>
              </div>

              <div class="form-actions">
                <button class="btn btn-primary" type="submit">Enviar pedido de cotação</button>
                <a class="btn btn-secondary" href="https://wa.me/556299998934" target="_blank" rel="noreferrer">Falar no WhatsApp</a>
              </div>

              <p class="form-status" id="form-status" aria-live="polite"></p>
              <div class="form-success" id="form-success">
                <strong>Pedido recebido.</strong>
                Nossa equipe entrará em contato pelos dados informados.
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="brand">
        <span class="brand-mark">CB</span>
        <span>CB Shows</span>
      </div>
      <div class="footer-links">
        <a href="#servicos">Serviços</a>
        <a href="#artistas">Artistas</a>
        <a href="#faq">FAQ</a>
        <a href="#contato">Contato</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  navToggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  const filterButtons = document.querySelectorAll('.filter-chip');
  const artistCards = document.querySelectorAll('.artist-card');
  const emptyState = document.getElementById('artist-empty');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filterValue = button.getAttribute('data-filter');

      filterButtons.forEach((chip) => chip.classList.toggle('active', chip === button));

      let visibleCount = 0;
      artistCards.forEach((card) => {
        const matches = filterValue === 'all' || card.dataset.category === filterValue;
        card.style.display = matches ? 'block' : 'none';
        if (matches) visibleCount += 1;
      });

      emptyState?.classList.toggle('visible', visibleCount === 0);
    });
  });

  const form = document.getElementById('quote-form');
  const formStatus = document.getElementById('form-status');
  const successBox = document.getElementById('form-success');

  const setFieldError = (field, message) => {
    field.classList.add('invalid');
    field.setAttribute('aria-invalid', 'true');
    field.setCustomValidity(message);
  };

  const clearFieldError = (field) => {
    field.classList.remove('invalid');
    field.removeAttribute('aria-invalid');
    field.setCustomValidity('');
  };

  const validateNext = (field, message) => {
    if (!field.value.trim()) {
      setFieldError(field, message);
      return false;
    }
    clearFieldError(field);
    return true;
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const fields = {
      name: document.getElementById('name'),
      phone: document.getElementById('phone'),
      email: document.getElementById('email'),
      demand: document.getElementById('demand'),
      eventType: document.getElementById('eventType'),
      location: document.getElementById('location'),
      date: document.getElementById('date'),
      privacy: document.getElementById('privacy'),
    };

    let valid = true;

    const phoneValue = fields.phone.value.trim();
    const emailValue = fields.email.value.trim();
    const dateValue = fields.date.value;

    if (!validateNext(fields.name, 'Preencha este campo para continuar.')) valid = false;
    if (!validateNext(fields.phone, 'Preencha este campo para continuar.')) valid = false;
    else if (!/^\(?\d{2}\)?\s?\d{4,5}-?\d{4}$/.test(phoneValue)) {
      setFieldError(fields.phone, 'Informe um telefone com DDD.');
      valid = false;
    } else clearFieldError(fields.phone);

    if (!validateNext(fields.email, 'Preencha este campo para continuar.')) valid = false;
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailValue)) {
      setFieldError(fields.email, 'Informe um e-mail válido.');
      valid = false;
    } else clearFieldError(fields.email);

    if (!validateNext(fields.demand, 'Preencha este campo para continuar.')) valid = false;
    if (!validateNext(fields.eventType, 'Preencha este campo para continuar.')) valid = false;
    if (!validateNext(fields.location, 'Preencha este campo para continuar.')) valid = false;

    const dateOpen = document.getElementById('dateOpen');
    if (!dateOpen.checked && !dateValue) {
      setFieldError(fields.date, 'Preencha este campo para continuar.');
      valid = false;
    } else if (!dateOpen.checked && dateValue) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      if (new Date(dateValue) < today) {
        setFieldError(fields.date, 'Escolha uma data futura ou marque que a data ainda não foi definida.');
        valid = false;
      } else clearFieldError(fields.date);
    } else clearFieldError(fields.date);

    if (!fields.privacy.checked) {
      fields.privacy.setCustomValidity('Preencha este campo para continuar.');
      fields.privacy.classList.add('invalid');
      valid = false;
    } else {
      fields.privacy.setCustomValidity('');
      fields.privacy.classList.remove('invalid');
    }

    if (!valid) {
      formStatus.textContent = 'Revise os campos obrigatórios.';
      formStatus.classList.add('error');
      formStatus.classList.remove('success');
      return;
    }

    formStatus.textContent = 'Enviando...';
    formStatus.classList.remove('error');
    formStatus.classList.add('success');

    const submitButton = form.querySelector('button[type="submit"]');
    submitButton.disabled = true;
    submitButton.textContent = 'Enviando...';

    setTimeout(() => {
      successBox?.classList.add('visible');
      formStatus.textContent = 'Pedido recebido. Nossa equipe entrará em contato pelos dados informados.';
      formStatus.classList.add('success');
      form.reset();
      submitButton.disabled = false;
      submitButton.textContent = 'Enviar pedido de cotação';
    }, 500);
  });
</script>
